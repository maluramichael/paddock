<Window x:Class="Paddock.Views.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Paddock.Views"
        x:Name="Self"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" ShowActivated="False"
        Background="Transparent" AllowDrop="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource P.FontFamily}" MinWidth="120" MinHeight="24"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="Chrome" CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Kachelansicht: Symbol über Beschriftung, wie auf dem Desktop -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type v:ItemViewModel}">
            <Border x:Name="Bd" Width="{Binding TileWidth, ElementName=Self}" Margin="{DynamicResource P.Item.Spacing}"
                    Padding="4,7,4,5" CornerRadius="6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                    ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="1000" ToolTipService.Placement="Bottom">
                <StackPanel>
                    <Grid Width="{Binding IconSize, ElementName=Self}" Height="{Binding IconSize, ElementName=Self}">
                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                    </Grid>
                    <TextBlock Text="{Binding Name}" Margin="0,5,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight"
                               LineHeight="{Binding LabelLineHeight, ElementName=Self}"
                               MaxHeight="{Binding LabelMaxHeight, ElementName=Self}"
                               Foreground="{DynamicResource P.Item.Foreground}" FontSize="{DynamicResource P.Item.FontSize}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource P.Item.Hover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource P.Item.Selected}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource P.Item.SelectedBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGhost}" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Listenansicht: kleines Symbol links, Name rechts -->
        <DataTemplate x:Key="ListTemplate" DataType="{x:Type v:ItemViewModel}">
            <Border x:Name="Bd" Width="{Binding ListItemWidth, ElementName=Self}" Margin="0,1" Padding="6,4" CornerRadius="5"
                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                    ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="1000">
                <DockPanel>
                    <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource P.Item.Foreground}" FontSize="{DynamicResource P.Item.FontSize}"/>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource P.Item.Hover}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource P.Item.Selected}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource P.Item.SelectedBorder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGhost}" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="HoverReveal" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Self}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Tönung über der DWM-Unschärfe -->
        <Border x:Name="TintLayer" Background="{DynamicResource P.Tint}" CornerRadius="{DynamicResource P.CornerRadius}"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titelleiste: ziehen = verschieben, klicken = einklappen, Rechtsklick = Menü -->
            <Border x:Name="TitleBar" Height="{DynamicResource P.Title.Height}" Background="{DynamicResource P.Title.Background}"
                    CornerRadius="{DynamicResource P.CornerRadius}" Cursor="Arrow">
                <Grid Margin="6,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BackButton" Style="{StaticResource P.IconButton}" Content="&#xE72B;" Visibility="Collapsed"
                            ToolTip="Zurück" Click="Back_Click"/>

                    <TextBlock x:Name="TitleText" Grid.Column="1" Margin="6,0" VerticalAlignment="Center"
                               HorizontalAlignment="{DynamicResource P.Title.Alignment}" TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource P.Title.FontFamily}" FontSize="{DynamicResource P.Title.FontSize}"
                               FontWeight="{DynamicResource P.Title.FontWeight}" Foreground="{DynamicResource P.Title.Foreground}"/>

                    <TextBox x:Name="TitleEdit" Grid.Column="1" Margin="2,0" Visibility="Collapsed" VerticalAlignment="Center"
                             Style="{StaticResource P.TextBox}" Padding="4,2" FontSize="{DynamicResource P.Title.FontSize}"
                             Foreground="{DynamicResource P.Title.Foreground}" CaretBrush="{DynamicResource P.Title.Foreground}"
                             KeyDown="TitleEdit_KeyDown" LostKeyboardFocus="TitleEdit_LostFocus"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LockIcon" Text="&#xE72E;" FontFamily="{StaticResource P.Icons}" FontSize="10" Margin="0,0,6,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource P.Title.Foreground}" Opacity="0.6"
                                   Visibility="Collapsed" ToolTip="Gesperrt"/>
                        <StackPanel Orientation="Horizontal" Style="{StaticResource HoverReveal}">
                            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"
                                       Foreground="{DynamicResource P.Title.Foreground}" Opacity="0.6"/>
                            <Button x:Name="MenuButton" Style="{StaticResource P.IconButton}" Content="&#xE712;" ToolTip="Menü"
                                    Click="MenuButton_Click"/>
                        </StackPanel>
                        <Button x:Name="CollapseButton" Style="{StaticResource P.IconButton}" Click="Collapse_Click">
                            <TextBlock x:Name="Chevron" Text="&#xE70E;" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><RotateTransform x:Name="ChevronRotate" Angle="0"/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Inhalt -->
            <Grid x:Name="Body" Grid.Row="1" Background="Transparent">
                <ScrollViewer x:Name="Scroller" Style="{StaticResource P.ScrollViewer}" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl x:Name="ItemsHost" Margin="6,4,6,8" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Opacity="0.55">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource P.Icons}" FontSize="22" HorizontalAlignment="Center"
                               Foreground="{DynamicResource P.Item.Foreground}"/>
                    <TextBlock x:Name="EmptyText" Text="Dateien hierher ziehen" Margin="0,8,0,0" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource P.Item.Foreground}"/>
                </StackPanel>

                <Canvas x:Name="Overlay" IsHitTestVisible="False">
                    <Border x:Name="InsertMarker" Width="3" CornerRadius="1.5" Background="{DynamicResource P.Accent}" Visibility="Collapsed"/>
                </Canvas>
            </Grid>

            <Border x:Name="DropGlow" Grid.RowSpan="2" BorderBrush="{DynamicResource P.Accent}" BorderThickness="2"
                    CornerRadius="{DynamicResource P.CornerRadius}" Background="{DynamicResource P.AccentSoft}"
                    Opacity="0" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
